if SHIELD_CYGNUS_DONGLE

config ZMK_KEYBOARD_NAME
    default "Cygnus"

config ZMK_SPLIT
    default y

# The dongle is the central: it holds the keymap and talks to the host.
config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Both halves are peripherals now.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 peripherals + 5 host BT profiles.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
